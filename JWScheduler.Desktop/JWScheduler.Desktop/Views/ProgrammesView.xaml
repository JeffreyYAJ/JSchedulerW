<UserControl x:Class="JWScheduler.Desktop.Views.ProgrammesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:JWScheduler.Desktop.Models">
    <Grid Margin="32">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,24">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Semaines &amp; Programmes" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="Gérez les semaines d'assemblée et planifiez les exposés." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Générer 8 semaines" Margin="0,0,8,0" Padding="16,10" Command="{Binding GenererSemainesCommand}" />
                        <Button Content="+ Nouvelle semaine" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCreateDialogCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Programmes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Programme}">
                        <Border Width="300" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="20" Margin="0,0,16,16" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenProgrammeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <TextBlock Text="{Binding DateDebutSemaine, StringFormat='Semaine du {0:dd MMMM}'}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding DateFinSemaine, StringFormat='Au {0:dd MMMM yyyy}'}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" />
                                <Border Background="#EEF2FF" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TypeLabel}" Foreground="#4338CA" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <Grid Background="#66000000" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Padding="24" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Créer une semaine" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date de début" FontWeight="SemiBold" />
                            <DatePicker SelectedDate="{Binding DateDebut}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date de fin" FontWeight="SemiBold" />
                            <DatePicker SelectedDate="{Binding DateFin}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Semaine spéciale (inclut un discours)" IsChecked="{Binding ContientDiscours}" Margin="0,16,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Margin="0,0,8,0" Padding="16,8" Command="{Binding CloseCreateDialogCommand}" />
                        <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Command="{Binding CreateProgrammeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
