<UserControl x:Class="JWScheduler.Desktop.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JWScheduler.Desktop.ViewModels.Pages">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Ordonnancement de la semaine" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="{Binding Programme.PeriodeLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Programme.TypeLabel}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Lecture" Margin="0,0,8,0" Padding="16,10"
                    Command="{Binding SelectSlotCommand}" CommandParameter="Lecture" />
            <Button Content="Sketch 1" Margin="0,0,8,0" Padding="16,10"
                    Command="{Binding SelectSlotCommand}" CommandParameter="Sketch 1" />
            <Button Content="Sketch 2" Margin="0,0,8,0" Padding="16,10"
                    Command="{Binding SelectSlotCommand}" CommandParameter="Sketch 2" />
            <Button Content="Sketch 3" Padding="16,10"
                    Command="{Binding SelectSlotCommand}" CommandParameter="Sketch 3" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Type pour Sketch 3 :" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
            <RadioButton Content="Sketch 3" GroupName="Sketch3Type" IsChecked="{Binding Sketch3IsDiscours, Converter={StaticResource InverseBool}}" Margin="0,0,12,0" />
            <RadioButton Content="Discours" GroupName="Sketch3Type" IsChecked="{Binding Sketch3IsDiscours}" />
        </StackPanel>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding CurrentSlots}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SlotAssignmentViewModel}">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding Rule}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding FlatStudents}"
                                      DisplayMemberPath="Nom"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedEleveId, Mode=TwoWay, TargetNullValue={x:Null}}"
                                      VerticalAlignment="Center" Padding="8" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Sauvegarder les affectations" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
