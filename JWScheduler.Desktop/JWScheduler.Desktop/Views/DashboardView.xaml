<UserControl x:Class="JWScheduler.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:JWScheduler.Desktop.Models">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Tableau de bord" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Vue d'ensemble des attributions et alertes d'exposés." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding GoToProgrammesCommand}" HorizontalAlignment="Right">
                Planifier
            </Button>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,24">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="EFFECTIF GLOBAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="{Binding TotalEleves}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text=" élèves inscrits" VerticalAlignment="Bottom" Margin="8,0,0,6" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="ALERTES PRIORITAIRES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="{Binding AlertesCount}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <Border Background="#FFE4E6" CornerRadius="999" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding AlertesCount, Converter={StaticResource CountToVis}}">
                            <TextBlock Text="Action requise" Foreground="#BE123C" FontWeight="Bold" FontSize="11" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Élèves en attente d'exposé" FontWeight="Bold" FontSize="16" Margin="20" />
                    <DataGrid ItemsSource="{Binding PriorityStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                            <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="80" />
                            <DataGridTextColumn Header="Dernier passage" Binding="{Binding DateDernierExpose, Converter={StaticResource DateFormat}}" Width="140" />
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Assigner" Command="{Binding DataContext.GoToProgrammesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Prochaines réunions" FontWeight="Bold" FontSize="16" Margin="20" />
                    <ItemsControl ItemsSource="{Binding UpcomingWeeks}" Margin="16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Programme}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12" Background="#FAFAFA" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateDebutSemaine, StringFormat='Semaine du {0:dd MMMM}'}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
