<UserControl x:Class="JWScheduler.Desktop.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:JWScheduler.Desktop.Models">
    <Grid Margin="32">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,24">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Gestion des Élèves" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="Gérez les profils et surveillez les retards d'exposés." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding OpenAddDialogCommand}" Content="+ Ajouter un élève" />
                </DockPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <DataGrid ItemsSource="{Binding Students}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Élève" Binding="{Binding Nom}" Width="*" />
                        <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="80" />
                        <DataGridTextColumn Header="Dernier exposé" Binding="{Binding DateDernierExpose, Converter={StaticResource DateFormat}}" Width="140" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="100" />
                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Eleve}">
                                    <Button Content="Suppr." Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#DC2626" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Add dialog -->
        <Grid Background="#66000000" Visibility="{Binding IsAddDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Padding="24" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Ajouter un élève" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="Nom complet" FontWeight="SemiBold" />
                    <TextBox Text="{Binding NewNom, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8" />
                    <TextBlock Text="Genre" FontWeight="SemiBold" />
                    <ComboBox SelectedValue="{Binding NewGenre}" SelectedValuePath="Tag" Margin="0,4,0,12" Padding="8">
                        <ComboBoxItem Content="Homme (H)" Tag="H" />
                        <ComboBoxItem Content="Femme (F)" Tag="F" />
                    </ComboBox>
                    <TextBlock Text="Date du dernier exposé (optionnel)" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding NewDateDernierExpose}" Margin="0,4,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Margin="0,0,8,0" Padding="16,8" Command="{Binding CloseAddDialogCommand}" />
                        <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Command="{Binding AddStudentCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Delete dialog -->
        <Grid Background="#66000000" Visibility="{Binding StudentToDelete, Converter={StaticResource NullToVis}}">
            <Border Background="White" CornerRadius="16" Padding="24" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Supprimer l'élève ?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Cette action est irréversible." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Annuler" Margin="0,0,8,0" Padding="16,8" Command="{Binding CancelDeleteCommand}" />
                        <Button Content="Confirmer" Background="#DC2626" Foreground="White" Padding="16,8" Command="{Binding ConfirmDeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
