{
  "name": "JWScheduler-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "author": "JeffreyYAJ <jeffreyyaj@gmail.com>",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start:frontend": "cd JSchedulerW_frontend && npm run dev",
    "start:electron": "wait-on http://localhost:5173 && electron . --no-sandbox",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:electron\"",
    "build:frontend": "cd JSchedulerW_frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "build": {
    "appId": "com.yaj.jwscheduler",
    "productName": "JW Scheduler",
    "asar": true,
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "JSchedulerW_backend/**/*",
      "JSchedulerW_frontend/dist/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
