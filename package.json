{
  "name": "JWScheduler-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "author": "JeffreyYAJ <jeffreyyaj@gmail.com>",

  "scripts": {
    "start:backend": "cd JSchedulerW_backend && npm start",
    "start:frontend": "cd JSchedulerW_frontend && npm run dev",
    "start:electron": "wait-on http://localhost:5173 && electron . --no-sandbox",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:electron\"",
    "build:frontend": "cd JSchedulerW_frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.yaj.jwscheduler",
    "productName": "jwscheduler",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "JSchedulerW_backend/**/*",
      "JSchedulerW_frontend/dist/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
